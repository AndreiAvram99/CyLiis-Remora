# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Postgres connection string (Render provides this automatically in prod)
DATABASE_URL="postgresql://user:password@localhost:5432/discordcal?schema=public"

# The single Discord server (guild) this instance manages
DISCORD_GUILD_ID="000000000000000000"

# IANA timezone used for displaying/scheduling event times
DEFAULT_TIMEZONE="Europe/Bucharest"

# ---------------------------------------------------------------------------
# Discord bot (worker) + OAuth (dashboard)
# ---------------------------------------------------------------------------
# Bot token from the Discord Developer Portal -> Bot
DISCORD_BOT_TOKEN="your-bot-token"

# Application ID / OAuth client credentials (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID="000000000000000000"
DISCORD_CLIENT_SECRET="your-oauth-client-secret"

# ---------------------------------------------------------------------------
# Dashboard (NextAuth)
# ---------------------------------------------------------------------------
# Public URL of the dashboard. Locally: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Login is limited to members of DISCORD_GUILD_ID (checked via OAuth at sign-in).

# Comma-separated Discord user IDs that are always full managers (bypass role).
ADMIN_DISCORD_IDS="000000000000000000"

# Members with this role get full management access; everyone else is view-only.
# Resolved by name via the bot token. Create this role in your Discord server.
MANAGER_ROLE_NAME="Remora"
# Optional: pin the exact role id(s), comma-separated, instead of matching by name.
MANAGER_ROLE_ID=""

# ---------------------------------------------------------------------------
# Google Calendar (service account)
# ---------------------------------------------------------------------------
# The full service-account JSON, single line (escaped) OR base64 encoded.
# On Render, paste the raw JSON as a secret env var.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# The calendar ID to write events into (share this calendar with the SA email).
GOOGLE_CALENDAR_ID="primary"
# Set to "false" to disable Google Calendar sync entirely.
GOOGLE_CALENDAR_ENABLED="true"

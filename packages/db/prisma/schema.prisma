// Prisma schema for the Discord + Google Calendar reminder bot.
// The dashboard is the only writer; the worker (bot + scheduler) reads and acts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventKind {
  MEETING
  EVENT
  CUSTOM
  PRINT // a file that needs printing; posts to a channel, no reminders/RSVP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum RsvpStatus {
  GOING
  NO
  MOTIVATED
}

/// A Discord server. This instance is single-guild, but the model supports more.
model Guild {
  id               String   @id // Discord guild id
  name             String
  defaultChannelId String?
  timezone         String   @default("Europe/Bucharest")
  memberCount      Int      @default(0) // updated by the bot, used for reach %
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  channels         Channel[]
  events           Event[]
  reminderDefaults ReminderDefault[]
}

/// Cache of Discord channels, kept in sync by the bot so the dashboard has a
/// live channel picker without needing to call Discord directly.
model Channel {
  id         String   @id // Discord channel id
  guildId    String
  name       String
  type       String // e.g. GuildText, GuildAnnouncement
  position   Int      @default(0)
  color      String? // admin-chosen hex (#RRGGBB) shown in channel pickers
  isTextable Boolean  @default(true)
  archived   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// A calendar event or meeting created from the dashboard.
model Event {
  id                      String    @id @default(cuid())
  guildId                 String
  title                   String
  description             String?
  kind                    EventKind @default(EVENT)
  startAt                 DateTime
  endAt                   DateTime?
  allDay                  Boolean   @default(false) // date-only (events); no time of day
  durationMinutes         Int? // meeting length; endAt is derived from it
  recurrence              String    @default("NONE") // NONE | WEEKLY | MONTHLY | YEARLY
  recurrenceActive        Boolean   @default(true) // false stops future occurrences
  seriesId                String? // groups occurrences of a recurring schedule
  location                String?
  url                     String?
  channelId               String // default target channel for announcements/reminders
  announceOnCreate        Boolean   @default(true)
  gcalEventId             String?
  gcalCalendarId          String? // which Google calendar the event was pushed to
  discordScheduledEventId String?
  interestedCount         Int       @default(0) // snapshot of Discord "interested" count
  printMessageId          String? // Discord message posted for a PRINT request
  printClaimedById        String? // Discord id of the member who took the print job
  printClaimedByName      String? // their display name at claim time
  printStatus             String    @default("PENDING") // PENDING | PRINTING | DONE
  createdBy               String? // Discord user id of the admin who created it
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  guild      Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reminders  Reminder[]
  rsvps      Rsvp[]
  printFiles PrintFile[]
  invitees   EventInvitee[]

  @@index([guildId])
  @@index([startAt])
  @@index([seriesId])
}

/// Cache of the guild's members and their role ids, refreshed from Discord so
/// the attendee picker doesn't hit the API on every page load.
model GuildMember {
  id          String   @id // Discord user id
  guildId     String
  username    String?
  displayName String? // guild nickname, falling back to global name
  avatarUrl   String?
  roles       String[] // Discord role ids held in this guild
  isBot       Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([guildId])
}

/// A member expected at a meeting. Absences are derived by comparing this list
/// against the meeting's RSVPs, so no-shows need no separate bookkeeping.
model EventInvitee {
  id          String   @id @default(cuid())
  eventId     String
  userId      String // Discord user id
  displayName String? // snapshot so the list survives nickname changes
  avatarUrl   String?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

/// A single file attached to a PRINT request, with its own importance and
/// print-queue order so a job's files can be prioritized individually.
model PrintFile {
  id        String   @id @default(cuid())
  eventId   String
  name         String
  url          String? // Discord attachment URL captured after posting
  order        Int      @default(0) // print-queue position (0 = unset)
  copies       Int      @default(1) // how many pieces to print
  filamentType String   @default("PLA") // PLA | PETG | ASA/ABS | TPU | ...
  infill       Int      @default(60) // infill percentage
  color        String   @default("#132884") // hex swatch
  wallCount    Int      @default(4) // number of perimeter walls
  needsSupport Boolean  @default(false)
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// A single reminder for an event. Stored as an absolute `dueAt` (precomputed
/// from startAt - offset) so the scheduler query is a trivial index scan.
model Reminder {
  id             String         @id @default(cuid())
  eventId        String
  offsetMinutes  Int // minutes before startAt (0 = at start time)
  channelId      String? // optional per-reminder channel override
  status         ReminderStatus @default(PENDING)
  dueAt          DateTime
  sentAt         DateTime?
  messageId      String?
  error          String?
  label          String? // human label e.g. "1 day before"
  isAnnouncement Boolean        @default(false) // the initial "event created" post
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([eventId])
}

/// Per-kind default reminder offsets that pre-fill the event creation form.
model ReminderDefault {
  id            String    @id @default(cuid())
  guildId       String
  kind          EventKind
  offsetMinutes Int
  label         String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, kind, offsetMinutes])
  @@index([guildId, kind])
}

/// RSVP state per user per event, driven by Discord buttons (presence tracking).
model Rsvp {
  id           String     @id @default(cuid())
  eventId      String
  userId       String // Discord user id
  username     String?
  displayName  String? // guild nickname / display name at RSVP time
  avatarUrl    String? // Discord avatar URL captured at RSVP time
  status       RsvpStatus
  note         String? // free-text reason submitted with a "Motivation" RSVP
  overriddenBy String? // Discord id of the manager who last corrected this
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

/// A mark awarded by hand by the master account, on top of the black marks
/// derived from missed meetings. BLACK counts against a member, WHITE counts
/// in their favour; the two are reported side by side.
model MemberMark {
  id        String   @id @default(cuid())
  guildId   String
  userId    String // Discord user id
  kind      String // BLACK | WHITE
  reason    String?
  createdBy String? // Discord id of the master who added it
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([userId])
}

/// Simple key/value store for misc settings and feature flags.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
